#!/usr/bin/env bash
set -euo pipefail

safe_output() { [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ ]]; }
safe_int() { [[ "${1:-}" =~ ^-?[0-9]+$ ]]; }
safe_transform() { [[ "${1:-}" =~ ^[0-3]$ ]]; }
monitor_eval() { hyprctl eval "$1" >/dev/null; }

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-monitor-blanker"
config_file="$config_dir/monitors.json"
hypr_config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/monitors.lua"
lua_config="$config_dir/monitors.lua"

current_monitor_json() {
  hyprctl monitors all -j | jq -e -c --arg name "$1" '.[] | select(.name == $name)'
}

validate_arrangement_file() {
  local file="$1" name x y transform info width height raw_width raw_height scale rect other_name other_x other_y other_width other_height
  local -a rects=()
  while IFS=$'\t' read -r name x y transform; do
    safe_output "$name" && safe_int "$x" && safe_int "$y" && safe_transform "$transform" || return 1
    info="$(current_monitor_json "$name" 2>/dev/null || true)"
    [[ -n "$info" ]] || continue
    raw_width="$(jq -r '.width' <<<"$info")"
    raw_height="$(jq -r '.height' <<<"$info")"
    scale="$(jq -r '.scale // 1' <<<"$info")"
    if [[ "$transform" == 1 || "$transform" == 3 ]]; then
      printf -v width '%s' "$(awk -v w="$raw_height" -v s="$scale" 'BEGIN { print w / s }')"
      printf -v height '%s' "$(awk -v w="$raw_width" -v s="$scale" 'BEGIN { print w / s }')"
    else
      printf -v width '%s' "$(awk -v w="$raw_width" -v s="$scale" 'BEGIN { print w / s }')"
      printf -v height '%s' "$(awk -v w="$raw_height" -v s="$scale" 'BEGIN { print w / s }')"
    fi
    for rect in "${rects[@]}"; do
      IFS='|' read -r other_name other_x other_y other_width other_height <<<"$rect"
      if awk -v ax="$x" -v ay="$y" -v aw="$width" -v ah="$height" \
        -v bx="$other_x" -v by="$other_y" -v bw="$other_width" -v bh="$other_height" \
        'BEGIN { exit ! (ax < bx + bw && ax + aw > bx && ay < by + bh && ay + ah > by) }'; then
        echo "Arrangement overlaps $name and $other_name." >&2
        return 1
      fi
    done
    rects+=("$name|$x|$y|$width|$height")
  done < <(jq -r '.[] | [.name, .x, .y, (.transform // 0)] | @tsv' "$file")
}

persist_transform() {
  local name="$1" transform="$2" tmp_file
  [[ -f "$config_file" ]] || return 0
  tmp_file="$(mktemp "$config_dir/monitors.json.XXXXXX")"
  jq --arg name "$name" --argjson transform "$transform" 'map(if .name == $name then .transform = $transform else . end)' "$config_file" > "$tmp_file"
  mv "$tmp_file" "$config_file"
}

ensure_lua_include() {
  [[ -f "$hypr_config" ]] || return 0
  grep -Fq 'omarchy-monitor-blanker/monitors.lua' "$hypr_config" && return 0
  printf '\n-- >>> omarchy-monitor-blanker (managed block)\ndofile("%s")\n-- <<< omarchy-monitor-blanker\n' "$lua_config" >> "$hypr_config"
}

write_lua_config() {
  [[ -f "$config_file" ]] || return 0
  mkdir -p "$config_dir"
  local tmp_file
  tmp_file="$(mktemp "$config_dir/monitors.lua.XXXXXX")"
  {
    printf '%s\n' '-- Generated by omarchy-monitor-blanker. Edit the main monitors.lua instead.'
    while IFS=$'\t' read -r name x y transform; do
      safe_output "$name" && safe_int "$x" && safe_int "$y" && safe_transform "$transform" || continue
      info="$(current_monitor_json "$name" 2>/dev/null || true)"
      [[ -n "$info" ]] || continue
      width="$(jq -r '.width' <<<"$info")"
      height="$(jq -r '.height' <<<"$info")"
      rate="$(jq -r '.refreshRate' <<<"$info")"
      scale="$(jq -r '.scale // 1' <<<"$info")"
      printf 'hl.monitor({ output = "%s", mode = "%sx%s@%s", position = "%sx%s", scale = %s, transform = %s })\n' \
        "$name" "$width" "$height" "$rate" "$x" "$y" "$scale" "$transform"
    done < <(jq -r '.[] | [.name, .x, .y, (.transform // 0)] | @tsv' "$config_file")
  } > "$tmp_file"
  mv "$tmp_file" "$lua_config"
  ensure_lua_include
}

apply_saved_config() {
  [[ -f "$config_file" ]] || return 0
  jq -e 'if type == "array" then . else error("arrangement must be an array") end' "$config_file" >/dev/null
  validate_arrangement_file "$config_file"
  while IFS=$'\t' read -r name x y transform; do
    safe_output "$name" && safe_int "$x" && safe_int "$y" && safe_transform "$transform" || continue
    info="$(current_monitor_json "$name" 2>/dev/null || true)"
    [[ -n "$info" ]] || continue
    width="$(jq -r '.width' <<<"$info")"
    height="$(jq -r '.height' <<<"$info")"
    rate="$(jq -r '.refreshRate' <<<"$info")"
    scale="$(jq -r '.scale // 1' <<<"$info")"
    monitor_eval "hl.monitor({ output = '$name', mode = '${width}x${height}@${rate}', position = '${x}x${y}', scale = ${scale}, transform = ${transform} })"
  done < <(jq -r '.[] | [.name, .x, .y, (.transform // 0)] | @tsv' "$config_file")
}

action="${1:-}"
target="${2:-}"

case "$action" in
  disable)
    safe_output "$target" || { echo "No valid monitor output supplied." >&2; exit 2; }
    monitor_eval "hl.monitor({ output = '$target', disabled = true })"
    notify-send -a "Monitor Blanker" "Monitor disabled" "$target" 2>/dev/null || true
    ;;
  restore)
    safe_output "$target" || { echo "No valid monitor output supplied." >&2; exit 2; }
    monitor_eval "hl.monitor({ output = '$target', disabled = false })"
    hyprctl reload >/dev/null
    apply_saved_config
    notify-send -a "Monitor Blanker" "Monitor restored" "$target" 2>/dev/null || true
    ;;
  rotate)
    rotation="${3:-}"
    safe_output "$target" && safe_transform "$rotation" || { echo "Invalid monitor rotation supplied." >&2; exit 2; }
    info="$(current_monitor_json "$target")"
    width="$(jq -r '.width' <<<"$info")"
    height="$(jq -r '.height' <<<"$info")"
    rate="$(jq -r '.refreshRate' <<<"$info")"
    scale="$(jq -r '.scale // 1' <<<"$info")"
    x="$(jq -r '.x' <<<"$info")"
    y="$(jq -r '.y' <<<"$info")"
    monitor_eval "hl.monitor({ output = '$target', mode = '${width}x${height}@${rate}', position = '${x}x${y}', scale = ${scale}, transform = ${rotation} })"
    persist_transform "$target" "$rotation"
    ;;
  save-arrangement)
    (( ( $# - 1 ) % 3 == 0 && $# >= 4 )) || { echo "Usage: $0 save-arrangement OUTPUT X Y ..." >&2; exit 2; }
    mkdir -p "$config_dir"
    tmp_file="$(mktemp "$config_dir/monitors.json.XXXXXX")"
    trap 'rm -f "$tmp_file"' EXIT
    {
      for ((i=2; i<=$#; i+=3)); do
        j=$((i + 1)); k=$((i + 2))
        name="${!i}"; x="${!j}"; y="${!k}"
        safe_output "$name" && safe_int "$x" && safe_int "$y" || { echo "Invalid arrangement entry." >&2; exit 2; }
        info="$(current_monitor_json "$name")"
        transform="$(jq -r '.transform // 0' <<<"$info")"
        jq -n --arg name "$name" --argjson x "$x" --argjson y "$y" --argjson transform "$transform" '{name:$name,x:$x,y:$y,transform:$transform}'
      done
    } | jq -s . > "$tmp_file"
    validate_arrangement_file "$tmp_file" || { echo "Arrangement overlaps another monitor; nothing was applied." >&2; exit 3; }
    mv "$tmp_file" "$config_file"
    trap - EXIT
    write_lua_config
    apply_saved_config
    notify-send -a "Monitor Blanker" "Monitor arrangement saved" 2>/dev/null || true
    ;;
  refresh)
    hyprctl reload >/dev/null
    apply_saved_config
    notify-send -a "Monitor Blanker" "Monitor configuration re-applied" 2>/dev/null || true
    ;;
  apply)
    apply_saved_config
    ;;
  *)
    echo "Usage: $0 {disable|restore|rotate|save-arrangement|refresh|apply}" >&2
    exit 2
    ;;
esac
